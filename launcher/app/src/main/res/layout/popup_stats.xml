<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:padding="6dp"
    android:elevation="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:text="@string/stats_panel_title"
        android:textColor="#8CFFFFFF"
        android:textSize="11sp"
        android:fontFamily="@string/font_medium"
        android:letterSpacing="0.18"
        android:textAllCaps="true" />

    <include
        android:id="@+id/statsCpuRow"
        layout="@layout/item_stats" />

    <include
        android:id="@+id/statsMemoryRow"
        layout="@layout/item_stats" />

    <include
        android:id="@+id/statsStorageRow"
        layout="@layout/item_stats" />
</LinearLayout>
